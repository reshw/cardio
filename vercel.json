{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"dev\" ]",
  "framework": "vite",
  "devCommand": "vite --port 3000",
  "buildCommand": "tsc -b && vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/webhooks/strava.ts": {
      "includeFiles": "api/fonts/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/monthly-snapshot",
      "schedule": "0 0 1 * *"
    },
    { "path": "/api/sync/trigger-all", "schedule": "0 22 * * *" },
    { "path": "/api/sync/trigger-all", "schedule": "0 1 * * *" },
    { "path": "/api/sync/trigger-all", "schedule": "0 4 * * *" },
    { "path": "/api/sync/trigger-all", "schedule": "0 8 * * *" },
    { "path": "/api/sync/trigger-all", "schedule": "0 12 * * *" }
  ]
}
