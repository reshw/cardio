# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Kakao OAuth
# REST API KEY: 카카오 공유하기(SDK) 에 사용 (노출 가능)
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
VITE_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here
# KAKAO_CLIENT_SECRET은 Supabase Dashboard > Auth > Providers > Kakao 에 입력.
# 프런트엔드 환경변수(VITE_)로 두지 말 것.

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_API_KEY=your_api_key_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Resend (이메일 발송)
# 주의: Netlify Functions에서 사용되므로 Netlify 환경변수로 설정 필요
# VITE_ 프리픽스 없이 RESEND_API_KEY로 설정
RESEND_API_KEY=your_resend_api_key_here

# Strava OAuth + Webhook
# https://www.strava.com/settings/api 에서 앱 생성 후 발급
VITE_STRAVA_CLIENT_ID=your_strava_client_id        # 프론트엔드용 (공개 가능)
STRAVA_CLIENT_ID=your_strava_client_id             # 서버사이드용
STRAVA_CLIENT_SECRET=your_strava_client_secret     # 절대 공개 금지
STRAVA_WEBHOOK_VERIFY_TOKEN=your_random_secret     # 웹훅 등록 시 사용할 임의 문자열 (직접 지정)
FRONTEND_URL=https://your-app.vercel.app           # OAuth 콜백 후 리다이렉트 URL
